   ============================================================ */

function loadCityReference() {
  console.log(
    "Loading city/state reference..."
  );

  const byState =
    new Map();

  const global =
    new Map();

  const lines =
    fs.readFileSync(
      CITIES_CSV,
      "utf8"
    )
    .split(/\r?\n/)
    .filter(Boolean);

  const header =
    parseCsvLine(
      lines.shift()
    );

  const nameIndex =
    header.indexOf("name");

  const asciiIndex =
    header.indexOf("name_ascii");

  const stateIndex =
    header.indexOf("state_code");

  for (const line of lines) {
    const columns =
      parseCsvLine(line);

    const state =
      String(
        columns[stateIndex] || ""
      )
      .trim()
      .toUpperCase();

    const canonical =
      String(
        columns[nameIndex] ||
        columns[asciiIndex] ||
        ""
      )
      .trim();

    if (
      !state ||
      !canonical
    ) {
      continue;
    }

    if (
      !byState.has(state)
    ) {
      byState.set(
        state,
        new Map()
      );
    }

    const stateCities =
      byState.get(state);

    for (const alias of [
      columns[nameIndex],
      columns[asciiIndex],
    ]) {
      const key =
        normalize(alias);

      if (key) {
        stateCities.set(
          key,
          canonical
        );
      }
    }

    const globalKey =
      normalize(canonical);

    if (
      !global.has(globalKey)
    ) {
      global.set(
        globalKey,
        new Set()
      );
    }

    global
      .get(globalKey)
      .add(state);
  }

  console.log(
    `Loaded city reference for ${byState.size} states/DC.`
  );

  return {
    byState,
    global,
  };
}

/* ============================================================
   LOAD ZIP REFERENCE
   ============================================================ */

function loadZipReference() {
  console.log(
    "Loading ZIP reference..."
  );

  const byZip =
    new Map();

  const lines =
    fs.readFileSync(
      ZIP_FILE,
      "utf8"
    )
    .split(/\r?\n/);

  for (const line of lines) {
    if (!line.trim()) {
      continue;
    }

    const columns =
      line.split("\t");

    /*
      GeoNames columns:

      0 country code
      1 postal code
      2 place name
      3 state name
      4 state code
    */

    if (
      columns[0] !== "US"
    ) {
      continue;
    }

    const zip =
      String(
        columns[1] || ""
      ).trim();

    const city =
      String(
        columns[2] || ""
      ).trim();

    const state =
      String(
        columns[4] || ""
      )
      .trim()
      .toUpperCase();

    if (
      !/^\d{5}$/.test(zip) ||
      !city ||
      !state
    ) {
      continue;
    }

    if (
      !byZip.has(zip)
    ) {
      byZip.set(
        zip,
        []
      );
    }

    byZip
      .get(zip)
      .push({
        city,
        state,
      });
  }

  console.log(
    `Loaded ${byZip.size.toLocaleString()} ZIP codes.`
  );

  return byZip;
}

const CITY_REFERENCE =
  loadCityReference();

const ZIP_REFERENCE =
  loadZipReference();

/* ============================================================
   ZIP EXTRACTION
   ============================================================ */

function zipFromValue(value) {
  for (
    const text of
    extractValues(value)
  ) {
    const match =
      text.match(
        /\b(\d{5})(?:-\d{4})?\b/
      );

    if (match) {
      return match[1];
    }
  }

  return null;
}

function resolveZip(row) {
  /*
    IMPORTANT:

    City is deliberately included here.

    Examples from the broken source data:

      City = "NV 89002"
      City = "NE 68512"

    Those contain useful ZIP evidence.
  */

  const fields = [
    getField(
      row,
      "Zip",
      "ZIP",
      "Zip_Code",
      "Zip Code",
      "Postal_Code",
      "Postal Code"
    ),

    getField(
      row,
      "City"
    ),

    getField(
      row,
      "Full_Address",
      "Full Address",
      "full_address",
      "fullAddress"
    ),

    getField(
      row,
      "Address"
    ),

    getField(
      row,
      "Location"
    ),

    getField(
      row,
      "Plus_Code",
      "Plus Code",
      "plus_code"
    ),
  ];

  for (const value of fields) {
    const zip =
      zipFromValue(value);

    if (zip) {
      return zip;
    }
  }

  return null;
}

/* ============================================================
   STATE EXTRACTION
   ============================================================ */

function stateFromValue(value) {
  for (
    const text of
    extractValues(value, "state")
  ) {
    const trimmed =
      text.trim();

    const upper =
      trimmed.toUpperCase();

    if (
      STATES[upper]
    ) {
      return upper;
    }

    const full =
      STATE_NAME_TO_CODE.get(
        normalize(trimmed)
      );

    if (full) {
      return full;
    }

    /*
      Handles:

      NV 89002
      Las Vegas, NV 89101
      NV, USA
    */

    const codeMatch =
      trimmed.match(
        /(?:^|[\s,])([A-Z]{2})(?=\s+\d{5}(?:-\d{4})?\b|[\s,]|$)/
      );

    if (
      codeMatch &&
      STATES[
        codeMatch[1]
      ]
    ) {
      return codeMatch[1];
    }

    for (
      const [code, name]
      of Object.entries(STATES)
    ) {
      const escaped =
        name.replace(
          /[.*+?^${}()|[\]\\]/g,
          "\\$&"
        );

      const regex =
        new RegExp(
          `(?:^|[^A-Za-z])${escaped}(?:$|[^A-Za-z])`,
          "i"
        );

      if (
        regex.test(trimmed)
      ) {
        return code;
      }
    }
  }

  return null;
}

function resolveState(
  row,
  filename
) {
  const fields = [
    getField(
      row,
      "State"
    ),

    /*
      City may actually contain
      state + ZIP.
    */
    getField(
      row,
      "City"
    ),

    getField(
      row,
      "Full_Address",
      "Full Address",
      "full_address",
      "fullAddress"
    ),

    getField(
      row,
      "Address"
    ),

    getField(
      row,
      "Location"
    ),

    getField(
      row,
      "Plus_Code",
      "Plus Code",
      "plus_code"
    ),

    filename,
  ];

  for (const value of fields) {
    const state =
      stateFromValue(value);

    if (state) {
      return state;
    }
  }

  /*
    Last fallback:
    infer state from ZIP.
  */

  const zip =
    resolveZip(row);

  if (
    zip &&
    ZIP_REFERENCE.has(zip)
  ) {
    const states =
      [
        ...new Set(
          ZIP_REFERENCE
            .get(zip)
            .map(
              item =>
                item.state
            )
        ),
      ];

    if (
      states.length === 1
    ) {
      return states[0];
    }
  }

  return null;
}

/* ============================================================
   CITY VALIDATION
   ============================================================ */

function canonicalCity(
  city,
  state
) {
  const key =
    normalize(city);

  if (!key) {
    return null;
  }

  if (
    state &&
    CITY_REFERENCE
      .byState
      .has(state)
  ) {
    const hit =
      CITY_REFERENCE
        .byState
        .get(state)
        .get(key);

    if (hit) {
      return hit;
    }
  }

  /*
    Without a known state, only accept
    a city name if the reference says it
    exists in exactly one state.
  */

  const states =
    CITY_REFERENCE
      .global
      .get(key);

  if (
    states &&
    states.size === 1
  ) {
    const onlyState =
      [...states][0];

    return (
      CITY_REFERENCE
        .byState
        .get(onlyState)
        .get(key) ||
      city
    );
  }

  return null;
}

function obviouslyNotCity(value) {
  const text =
    String(
      value || ""
    ).trim();

  if (!text) {
    return true;
  }

  /*
    CRITICAL FIX.

    Reject:

      NV 89002
      NE 68512
      89123

    as CITY values.

    Their ZIP/state information is
    still used elsewhere.
  */

  if (/\d/.test(text)) {
    return true;
  }

  if (
    STATES[
      text.toUpperCase()
    ]
  ) {
    return true;
  }

  if (
    STATE_NAME_TO_CODE.has(
      normalize(text)
    )
  ) {
    return true;
  }

  if (
    /\bcounty\b/i.test(text)
  ) {
    return true;
  }

  if (
    /\b(?:usa|united states)\b/i
      .test(text)
  ) {
    return true;
  }

  return false;
}

/* ============================================================
   ADDRESS CITY PARSING
   ============================================================ */

function citiesFromAddress(
  value,
  knownState
) {
  const output = [];

  for (
    const text of
    extractValues(value)
  ) {
    /*
      Example:

      123 Main St,
      Las Vegas,
      NV 89101
    */

    const regex =
      /,\s*([^,]+?)\s*,\s*([A-Z]{2})\s+\d{5}(?:-\d{4})?\b/gi;

    let match;

    while (
      (
        match =
          regex.exec(text)
      )
    ) {
      const state =
        match[2]
          .toUpperCase();

      if (
        !STATES[state]
      ) {
        continue;
      }

      if (
        knownState &&
        knownState !== state
      ) {
        continue;
      }

      output.push({
        city:
          match[1].trim(),

        state,
      });
    }
  }

  return output;
}

/* ============================================================
   CANDIDATE SCORING
   ============================================================ */

function addCandidate(
  candidates,
  rawCity,
  state,
  score,
  source,
  detail
) {
  if (
    obviouslyNotCity(
      rawCity
    )
  ) {
    return;
  }

  const city =
    canonicalCity(
      rawCity,
      state
    );

  if (!city) {
    return;
  }

  const key =
    `${state || ""}|${normalize(city)}`;

  if (
    !candidates.has(key)
  ) {
    candidates.set(
      key,
      {
        city,
        state:
          state || null,

        score: 0,

        evidence: [],
      }
    );
  }

  const candidate =
    candidates.get(key);

  candidate.score +=
    score;

  candidate
    .evidence
    .push({
      source,
      detail,
      score,
    });
}

/* ============================================================
   CITY RESOLVER
   ============================================================ */

function resolveCity(
  row,
  filename
) {
  const state =
    resolveState(
      row,
      filename
    );

  const zip =
    resolveZip(row);

  const candidates =
    new Map();

  /* -----------------------------
     1. EXPLICIT CITY
     ----------------------------- */

  const cityField =
    getField(
      row,
      "City"
    );

  for (
    const rawCity of
    extractValues(
      cityField,
      "city"
    )
  ) {
    addCandidate(
      candidates,
      rawCity,
      state,
      60,
      "explicit-city",
      rawCity
    );
  }

  /* -----------------------------
     2. ZIP -> CITY

     This is where:

       NV 89002

     becomes a real city.
     ----------------------------- */

  if (
    zip &&
    ZIP_REFERENCE.has(zip)
  ) {
    for (
      const item of
      ZIP_REFERENCE.get(zip)
    ) {
      if (
        state &&
        item.state !== state
      ) {
        continue;
      }

      addCandidate(
        candidates,
        item.city,
        item.state,
        80,
        "zip",
        zip
      );
    }
  }

  /* -----------------------------
     3. ADDRESS
     ----------------------------- */

  const addressFields = [
    [
      "full-address",

      getField(
        row,
        "Full_Address",
        "Full Address",
        "full_address",
        "fullAddress"
      ),
    ],

    [
      "address",

      getField(
        row,
        "Address"
      ),
    ],

    [
      "location",

      getField(
        row,
        "Location"
      ),
    ],
  ];

  for (
    const [
      label,
      value,
    ]
    of addressFields
  ) {
    for (
      const result of
      citiesFromAddress(
        value,
        state
      )
    ) {
      addCandidate(
        candidates,
        result.city,
        result.state,
        50,
        label,
        scalar(value)
      );
    }
  }

  /* -----------------------------
     RANK
     ----------------------------- */

  const ranked =
    [...candidates.values()]
      .sort(
        (a, b) =>
          b.score -
            a.score ||
          a.city.localeCompare(
            b.city
          )
      );

  if (
    ranked.length === 0
  ) {
    return {
      city: null,
      state,
      zip,

      status:
        "unresolved",

      confidence: 0,

      evidence: [],
    };
  }

  const best =
    ranked[0];

  const second =
    ranked[1];

  const ambiguous =
    Boolean(
      second &&
      second.city !==
        best.city &&
      second.score >=
        best.score - 10
    );

  let confidence;

  if (
    best.score >= 130
  ) {
    confidence = 0.99;
  } else if (
    best.score >= 80
  ) {
    confidence = 0.94;
  } else if (
    best.score >= 60
  ) {
    confidence = 0.88;
  } else {
    confidence = 0.78;
  }

  const evidenceSources =
    new Set(
      best.evidence.map(
        item =>
          item.source
      )
    );

  if (
    evidenceSources.size >= 2
  ) {
    confidence =
      Math.min(
        0.99,
        confidence + 0.04
      );
  }

  if (ambiguous) {
    confidence =
      Math.min(
        confidence,
        0.70
      );
  }

  return {
    city:
      best.city,

    state:
      best.state ||
      state,

    zip,

    status:
      ambiguous
        ? "ambiguous"
        : "resolved",

    confidence,

    evidence:
      best.evidence,

    alternatives:
      ambiguous
        ? ranked.slice(
            1,
            4
          )
        : undefined,
  };
}

/* ============================================================
   SOURCE ROW HANDLING
   ============================================================ */

function rowsFromJson(data) {
  if (
    Array.isArray(data)
  ) {
    return data;
  }

  if (
    !data ||
    typeof data !== "object"
  ) {
    return [];
  }

  if (
    Array.isArray(
      data.rows
    )
  ) {
    return data.rows;
  }

  const values =
    Object.values(data);

  if (
    values.length &&
    values.every(
      value =>
        value &&
        typeof value ===
          "object"
    )
  ) {
    return values;
  }

  return [];
}

function businessName(row) {
  const fields = [
    getField(
      row,
      "Name"
    ),

    getField(
      row,
      "Business_Name",
      "Business Name"
    ),

    getField(
      row,
      "Company_Name",
      "Company Name"
    ),

    getField(
      row,
      "Title"
    ),
  ];

  for (
    const value of fields
  ) {
    const text =
      scalar(value);

    if (text) {
      return text;
    }
  }

  return null;
}

/* ============================================================
   PERSISTENCE
   ============================================================ */

function appendJsonLine(
  filename,
  object
) {
  fs.appendFileSync(
    filename,
    JSON.stringify(object) +
      "\n"
  );
}

function saveCheckpoint(
  checkpoint
) {
  const temporary =
    `${CHECKPOINT}.tmp`;

  fs.writeFileSync(
    temporary,
    JSON.stringify(
      checkpoint,
      null,
      2
    ) + "\n"
  );

  fs.renameSync(
    temporary,
    CHECKPOINT
  );
}

function loadCheckpoint() {
  if (
    !fs.existsSync(
      CHECKPOINT
    )
  ) {
    return null;
  }

  try {
    return JSON.parse(
      fs.readFileSync(
        CHECKPOINT,
        "utf8"
      )
    );
  } catch (error) {
    console.error(
      "WARNING: checkpoint could not be read."
    );

    return null;
  }
}

