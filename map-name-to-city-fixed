function normalize(value) {
  return String(value ?? "")
    .normalize("NFKD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/&/g, " and ")
    .replace(/[^a-z0-9]+/g, " ")
    .trim()
    .replace(/\s+/g, " ");
}

const STATE_NAME_TO_CODE = new Map(
  Object.entries(STATES).map(
    ([code, name]) => [normalize(name), code]
  )
);

/* ============================================================
   GENERIC FIELD ACCESS
   ============================================================ */

function normalizedKey(key) {
  return normalize(key).replace(/ /g, "");
}

function getField(row, ...wanted) {
  if (
    !row ||
    typeof row !== "object" ||
    Array.isArray(row)
  ) {
    return undefined;
  }

  for (const name of wanted) {
    if (
      Object.prototype.hasOwnProperty.call(
        row,
        name
      )
    ) {
      return row[name];
    }
  }

  const map = new Map();

  for (const key of Object.keys(row)) {
    map.set(
      normalizedKey(key),
      row[key]
    );
  }

  for (const name of wanted) {
    const key =
      normalizedKey(name);

    if (map.has(key)) {
      return map.get(key);
    }
  }

  return undefined;
}

function scalar(value) {
  if (
    value === null ||
    value === undefined
  ) {
    return "";
  }

  if (typeof value === "object") {
    return "";
  }

  return String(value).trim();
}

/*
  Handles collision arrays such as:

  [
    {
      note: "city",
      type: "...",
      value: "Las Vegas"
    },
    {
      note: "...",
      type: "...",
      value: "..."
    }
  ]
*/

function extractValues(
  value,
  preferredNote = null
) {
  if (
    value === null ||
    value === undefined
  ) {
    return [];
  }

  if (!Array.isArray(value)) {
    if (
      typeof value === "object" &&
      Object.prototype.hasOwnProperty.call(
        value,
        "value"
      )
    ) {
      return extractValues(
        value.value,
        preferredNote
      );
    }

    const text =
      scalar(value);

    return text
      ? [text]
      : [];
  }

  const preferred = [];
  const other = [];

  for (const item of value) {
    if (
      item &&
      typeof item === "object"
    ) {
      const text =
        scalar(item.value);

      if (!text) {
        continue;
      }

      if (
        preferredNote &&
        normalize(item.note) ===
          preferredNote
      ) {
        preferred.push(text);
      } else {
        other.push(text);
      }
    } else {
      const text =
        scalar(item);

      if (text) {
        other.push(text);
      }
    }
  }

  return [
    ...preferred,
    ...other,
  ];
}

/* ============================================================
   CSV PARSER
   ============================================================ */

function parseCsvLine(line) {
  const output = [];

  let current = "";
  let quoted = false;

  for (
    let i = 0;
    i < line.length;
    i++
  ) {
    const char = line[i];

    if (char === '"') {
      if (
        quoted &&
        line[i + 1] === '"'
      ) {
        current += '"';
        i++;
      } else {
        quoted = !quoted;
      }
    } else if (
      char === "," &&
      !quoted
    ) {
      output.push(current);
      current = "";
    } else {
      current += char;
    }
  }

  output.push(current);

  return output;
}

/* ============================================================
