    Number(
      checkpoint
        ?.processed ||
      0
    );

  let resolved =
    Number(
      checkpoint
        ?.resolved ||
      0
    );

  let ambiguous =
    Number(
      checkpoint
        ?.ambiguous ||
      0
    );

  let unresolved =
    Number(
      checkpoint
        ?.unresolved ||
      0
    );

  console.log(
    "\n========================================"
  );

  console.log(
    " RESUMABLE NAME -> CITY RESOLVER"
  );

  console.log(
    "========================================\n"
  );

  console.log(
    `Sources:     ${files.length}`
  );

  console.log(
    `Output:      ${OUTPUT}`
  );

  console.log(
    `Diagnostics: ${DIAGNOSTICS}`
  );

  console.log(
    `Checkpoint:  ${CHECKPOINT}`
  );

  console.log(
    `Save every:  ${CHECKPOINT_EVERY} rows`
  );

  if (checkpoint) {
    console.log(
      "\nRESUMING"
    );

    console.log(
      `Processed: ${processed.toLocaleString()}`
    );

    console.log(
      `File: ${resumeFile || "(between files)"}`
    );

    console.log(
      `Next row: ${(
        resumeRow + 1
      ).toLocaleString()}`
    );
  }

  /* ========================================================
     FILE LOOP
     ======================================================== */

  for (
    let fileIndex = 0;
    fileIndex <
      files.length;
    fileIndex++
  ) {
    const filename =
      files[fileIndex];

    if (
      completedFiles.has(
        filename
      )
    ) {
      console.log(
        `[FILE ${fileIndex + 1}/${files.length}] SKIP completed: ${filename}`
      );

      continue;
    }

    console.log(
      `\n----------------------------------------`
    );

    console.log(
      `[FILE ${fileIndex + 1}/${files.length}] ${filename}`
    );

    console.log(
      `----------------------------------------`
    );

    const fullPath =
      path.join(
        JSON_DIR,
        filename
      );

    let data;

    try {
      data =
        JSON.parse(
          fs.readFileSync(
            fullPath,
            "utf8"
          )
        );
    } catch (error) {
      console.error(
        `FILE ERROR: ${error.message}`
      );

      appendJsonLine(
        DIAGNOSTICS,
        {
          filename,
          status:
            "file-error",
          error:
            error.message,
        }
      );

      completedFiles.add(
        filename
      );

      saveCheckpoint({
        completedFiles:
          [...completedFiles],

        currentFile:
          null,

        nextRow:
          0,

        processed,
        resolved,
        ambiguous,
        unresolved,
      });

      continue;
    }

    const rows =
      rowsFromJson(data);

    let startRow = 0;

    if (
      filename ===
      resumeFile
    ) {
      startRow =
        Math.min(
          resumeRow,
          rows.length
        );
    }

    console.log(
      `Rows: ${rows.length.toLocaleString()}`
    );

    console.log(
      `Starting row: ${(startRow + 1).toLocaleString()}`
    );

    /* ======================================================
       ROW LOOP
       ====================================================== */

    for (
      let rowIndex =
        startRow;

      rowIndex <
        rows.length;

      rowIndex++
    ) {
      const row =
        rows[rowIndex];

      processed++;

      const name =
        businessName(row);

      if (!name) {
        appendJsonLine(
          DIAGNOSTICS,
          {
            filename,
            row:
              rowIndex + 1,

            status:
              "no-name",
          }
        );

        console.log(
          `[NO-NAME] ${fileIndex + 1}/${files.length} ` +
          `row ${rowIndex + 1}/${rows.length}`
        );
      } else {
        const result =
          resolveCity(
            row,
            filename
          );

        if (
          result.status ===
          "resolved"
        ) {
          resolved++;
        } else if (
          result.status ===
          "ambiguous"
        ) {
          ambiguous++;
        } else {
          unresolved++;
        }

        /*
          WRITE RESULT IMMEDIATELY.

          This is deliberately JSONL.

          Each line is independently valid JSON.
          We do NOT need the entire dataset in RAM.
        */

        appendJsonLine(
          OUTPUT,
          {
            name,

            city:
              result.city,

            state:
              result.state,

            zip:
              result.zip,

            source_file:
              filename,

            source_row:
              rowIndex + 1,

            status:
              result.status,

            confidence:
              result.confidence,
          }
        );

        appendJsonLine(
          DIAGNOSTICS,
          {
            name,

            filename,

            row:
              rowIndex + 1,

            ...result,
          }
        );

        const marker =
          result.status ===
          "resolved"
            ? "OK"
            : result.status ===
                "ambiguous"
              ? "AMBIG"
              : "MISS";

        console.log(
          `[${marker}] ` +
          `${fileIndex + 1}/${files.length} ` +
          `row ${rowIndex + 1}/${rows.length} | ` +
          `${name} -> ` +
          `${result.city || "(unresolved)"}` +
          `${result.state ? ", " + result.state : ""}` +
          `${result.zip ? " | ZIP " + result.zip : ""}`
        );
      }

      /*
        CHECKPOINT.

        nextRow is zero-based index of the
        NEXT row to process.
      */

      if (
        (
          rowIndex + 1
        ) %
          CHECKPOINT_EVERY ===
        0
      ) {
        saveCheckpoint({
          completedFiles:
            [...completedFiles],

          currentFile:
            filename,

          nextRow:
            rowIndex + 1,

          processed,
          resolved,
          ambiguous,
          unresolved,

          savedAt:
            new Date()
              .toISOString(),
        });

        console.log(
          `>>> CHECKPOINT SAVED | ` +
          `processed=${processed.toLocaleString()} | ` +
          `resolved=${resolved.toLocaleString()} | ` +
          `ambiguous=${ambiguous.toLocaleString()} | ` +
          `unresolved=${unresolved.toLocaleString()}`
        );
      }
    }

    /*
      Release reference to the giant source object
      before opening another file.
    */

    data = null;

    completedFiles.add(
      filename
    );

    resumeFile =
      null;

    resumeRow =
      0;

    saveCheckpoint({
      completedFiles:
        [...completedFiles],

      currentFile:
        null,

      nextRow:
        0,

      processed,
      resolved,
      ambiguous,
      unresolved,

      savedAt:
        new Date()
          .toISOString(),
    });

    console.log(
      `>>> FILE COMPLETE: ${filename}`
    );
  }

  console.log(
    "\n========================================"
  );

  console.log(
    " COMPLETE"
  );

  console.log(
    "========================================\n"
  );

  console.log(
    `Processed:  ${processed.toLocaleString()}`
  );

  console.log(
    `Resolved:   ${resolved.toLocaleString()}`
  );

  console.log(
    `Ambiguous:  ${ambiguous.toLocaleString()}`
  );

  console.log(
    `Unresolved: ${unresolved.toLocaleString()}`
  );

  console.log(
    `\nOutput:\n${OUTPUT}`
  );

  console.log(
    `\nDiagnostics:\n${DIAGNOSTICS}`
  );

  console.log(
    `\nCheckpoint:\n${CHECKPOINT}`
  );
}

main();